/* Указываем компилятору, что начальная точка входа в ОС — это метка _start из boot.s */
ENTRY(_start)

SECTIONS
{
    /* Начинаем размещать элементы в памяти, начиная с адреса 1 Мегабайт (0x100000).
       Это стандартное безопасное место, так как память ниже зарезервирована под BIOS и VGA */
    . = 0x100000;

    /* Секция кода */
    .text BLOCK(4K) : ALIGN(4K)
    {
        /* Важнейшая строка: первыми в файле ОБЯЗАТЕЛЬНО должны идти 
           магические метки Multiboot, иначе GRUB/QEMU не признают этот файл как ОС */
        *(.multiboot)
        *(.text)
    }

    /* Секция констант (только для чтения, например, строки и текст команд) */
    .rodata BLOCK(4K) : ALIGN(4K)
    {
        *(.rodata)
    }

    /* Секция инициализированных глобальных переменных */
    .data BLOCK(4K) : ALIGN(4K)
    {
        *(.data)
    }

    /* Секция неинициализированных переменных и системный стек памяти */
    .bss BLOCK(4K) : ALIGN(4K)
    {
        *(COMMON)
        *(.bss)
    }
}
